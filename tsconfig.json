{
  "extends": "@total-typescript/tsconfig/bundler/dom/app",
  "include": [
    "parts/**/*.ts",
    "parts**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ],
  "exclude": ["gitignore/**"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ppc/parts": ["./parts/*"]
    },
    "allowImportingTsExtensions": true,
    "types": ["@remix-run/node", "vite/client", "@auth/core/types"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    //"paths": {
    //"~/*": ["./app/*"]
    //"parts", "apps"
    //},
    "noEmit": true
  }
}
