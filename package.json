{
  "name": "ppc-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./parts/index.ts"
  },
  "scripts": {
    "build": "remix vite:build && tsc --project ./tsconfig.server.json",
    "dev": "cross-env NODE_ENV=development tsx --watch-path ./apps/server.ts ./apps/server.ts",
    "format": "prettier --ignore-path .gitignore --ignore-unknown --cache --cache-location node_modules/.cache/prettiercache --write .",
    "lint": "eslint --ignore-path .gitignore --no-error-on-unmatched-pattern --cache --cache-location node_modules/.cache/eslint --fix .",
    "start": "cross-env NODE_ENV=production tsx --tsconfig tsconfig.server.json ./apps/server.ts",
    "typecheck": "tsc",
    "build:obsidian": "vite build --config ./apps/obsidian_plugin/vite.config.ts",
    "dev:obsidian": "node ./apps/obsidian_plugin/esbuild.config.mjs development"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/middie": "^9.0.3",
    "@fastify/one-line-logger": "^2.0.2",
    "@fastify/static": "^8.2.0",
    "@instantdb/admin": "^0.22.118",
    "@instantdb/react": "^0.22.118",
    "@libsql/client": "^0.17.0",
    "@mcansh/remix-fastify": "4.1.2",
    "@mridang/fastify-auth": "^1.1.0",
    "@remix-run/node": "*",
    "@remix-run/react": "*",
    "@remix-run/server-runtime": "*",
    "builtin-modules": "^5.0.0",
    "cac": "^6.7.14",
    "chalk": "^5.4.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "esbuild": "^0.27.2",
    "fastify": "^5.3.3",
    "get-port": "^7.1.0",
    "isbot": "^5.1.28",
    "obsidian": "^1.11.4",
    "openid-client": "^6.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@remix-run/dev": "*",
    "@remix-run/eslint-config": "*",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/source-map-support": "^0.5.10",
    "eslint": "^8.57.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
