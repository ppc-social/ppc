{
	"compilerOptions": {
    	"target": "ES2022",
    	"strict": true,
    	"module": "nodenext",
    	"moduleResolution": "nodenext",
    	"esModuleInterop": true,
    	"skipLibCheck": true,
    	"forceConsistentCasingInFileNames": true,
    	"declaration": true,
    	"declarationMap": true,
    	"sourceMap": true
	}
}
